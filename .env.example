# ─── NetMonitor configuration ────────────────────────────────────────────────
# Copy to .env and change every secret before exposing this stack.

HTTP_PORT=8080
HTTP_BIND=127.0.0.1
CUSTOM_ICONS_PATH=./custom-icons
TZ=Europe/Madrid
# Public HTTPS URL reachable by Telegram for interactive buttons
PUBLIC_URL=http://localhost:8080

POSTGRES_DB=netmonitor
POSTGRES_USER=netmonitor
POSTGRES_PASSWORD=netmonitor_change_me

# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret-in-production
# Used to encrypt SNMP/RouterOS credentials, notification tokens and report storage at rest.
# Do not change it after the first start without re-encrypting the database.
ENCRYPTION_KEY=change-this-encryption-key-in-production
# Optional: load/store the key from a mounted JSON file or Vault KV v2
ENCRYPTION_KEY_FILE=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/netmonitor
# External command that prints the key (KMS/HSM CLI)
ENCRYPTION_KEY_CMD=
# Automatic rotation in days (0 disables; requires file or Vault)
ENCRYPTION_KEY_ROTATION_DAYS=0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Set to true only for a disposable local lab. Production refuses default secrets.
ALLOW_INSECURE_DEFAULTS=false

# Polling / performance
POLLER_WORKERS=64
POLL_INTERVAL_SEC=30
# Maximum external notifications per minute across all rules (anti-storm; 0 disables)
ALERT_MAX_PER_MINUTE=120

# HA: only one core instance runs poller/receivers (PostgreSQL advisory lock)
CORE_LEADER_ELECTION=false

# PostgreSQL backups (netmonitor-backup sidecar)
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY=true

# Optional UDP receivers (host port -> container port)
SNMP_TRAP_PORT=162
SYSLOG_PORT=514

# Generated reports and exports (Docker Compose mounts ./reports at /app/reports)
REPORT_DIR=./reports

# Demo topology is only created when the DB is empty.
SEED_DEMO=true

# Optional TLS front door
DOMAIN=localhost
TLS_EMAIL=internal

# Optional remote probe agent (create token in Settings → Agentes)
AGENT_TOKEN=
AGENT_CORE_WS_URL=ws://netmonitor:8080/api/v1/agent/ws
AGENT_INSECURE_TLS=false

# Optional mutual TLS for remote agents
AGENT_TLS_ENABLED=false
AGENT_MTLS_PORT=8443
# For mTLS, use: AGENT_CORE_WS_URL=wss://netmonitor:8443/api/v1/agent/ws
AGENT_TLS_SERVER_NAME=netmonitor
# Rellena estas rutas solo si el agente usa mTLS
# AGENT_TLS_CERT=/app/certs/client.crt
# AGENT_TLS_KEY=/app/certs/client.key
# AGENT_TLS_CA=/app/certs/ca.crt

# Ed25519 public key (base64) used to verify signed agent updates
AGENT_UPDATE_PUBLIC_KEY=
